# Copy this file to .env and fill in your values.
# All variables are optional unless marked REQUIRED.

# ── LLM Routing (OmniRoute) ──────────────────────────────────────────────────
# OmniRoute local server base URL (default: http://localhost:20128/v1)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# API key for OmniRoute access control (leave as "omniroute" if not enabled)
OMNIROUTE_API_KEY=omniroute
# Specific OmniRoute model / combo to use (default: auto)
OMNIROUTE_MODEL=auto
# Cloud fallback key (optional — enables tier-2 cloud routing)
OMNIROUTE_CLOUD_KEY=

# ── Groq (tier-3 LLM fallback) ───────────────────────────────────────────────
GROQ_API_KEY=

# ── YouTube API (REQUIRED for upload) ────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── Whisper transcription device ─────────────────────────────────────────────
# cpu | cuda
WHISPER_DEVICE=cpu

# ── Docker / server config ───────────────────────────────────────────────────
HOST_PORT=8000
WORKERS=1
