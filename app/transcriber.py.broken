cat > app/transcriber.py <<'PY'
"""Groq Whisper transcription for ClipForge."""

from __future__ import annotations

import json
import logging
import os
import subprocess
import tempfile
from pathlib import Path
from typing import Callable, Optional

from groq import Groq

from .models import TranscriptionError
from .paths import TRANSCRIPTS_DIR

logger = logging.getLogger(__name__)

GROQ_MODEL = "whisper-large-v3-turbo"


def _normalize_language(language: Optional[str]) -> Optional[str]:
    if not language:
        return None

    lang = language.strip().lower()

    if lang in ("", "auto"):
        return None

    if lang == "hinglish":
        return "hi"

    return lang


def available_devices() -> list[str]:
    """ClipForge UI compatibility."""
    return ["cloud"]


def cuda_available() -> bool:
    return False


def gpu_name() -> Optional[str]:
    return None


def is_loaded(device: str) -> bool:
    return True


def get_device() -> str:
    return "cloud"


def load_model(device: str = "auto"):
    """Compatibility function; Groq does not require a local model."""
    if not os.environ.get("GROQ_API_KEY"):
        raise TranscriptionError(
            "GROQ_API_KEY is not set. Run: export GROQ_API_KEY='your-key'"
        )

    return True


def _get_duration(video_path: Path) -> float:
    """Get video duration using ffprobe."""
    try:
        result = subprocess.run(
            [
                "ffprobe",
                "-v",
                "error",
                "-show_entries",
                "format=duration",
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                str(video_path),
            ],
            capture_output=True,
            text=True,
            check=True,
        )
        return float(result.stdout.strip())
    except Exception:
        return 0.0


def _extract_audio(video_path: Path, output_path: Path) -> None:
    """Extract small mono 16 kHz MP3 suitable for the Groq API."""
    cmd = [
        "ffmpeg",
        "-y",
        "-i",
        str(video_path),
        "-vn",
        "-ac",
        "1",
        "-ar",
        "16000",
        "-b:a",
        "32k",
        str(output_path),
    ]

    result = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )

    if result.returncode != 0:
        raise RuntimeError(
            "FFmpeg could not extract the audio:\n" + result.stderr[-3000:]
        )


def transcribe_video(
    video_path: Path,
    clip_id: str,
    progress: Optional[Callable[[float, str], None]] = None,
    device: str = "auto",
    language: Optional[str] = None,
) -> dict:
    """
    Transcribe video through Groq Whisper.

    Returns the same structure expected by ClipForge:
      language
      duration
      text
      words
      segments
    """

    api_key = os.environ.get("GROQ_API_KEY")

    if not api_key:
        raise TranscriptionError(
            "GROQ_API_KEY is not set. Run:\n"
            "export GROQ_API_KEY='YOUR_KEY'"
        )

    if not video_path.exists():
        raise TranscriptionError(f"Video not found: {video_path}")

    try:
        if progress:
            progress(0.02, "Preparing audio for Groq Whisper...")

        duration = _get_duration(video_path)

        # Temporary compressed audio keeps uploads small.
        with tempfile.NamedTemporaryFile(
            suffix=".mp3",
            delete=False,
        ) as tmp:
            audio_path = Path(tmp.name)

        try:
            _extract_audio(video_path, audio_path)

            if progress:
                progress(0.20, "Uploading audio to Groq Whisper...")

            client = Groq(api_key=api_key)

            whisper_language = _normalize_language(language)

            kwargs = {
                "file": audio_path.open("rb"),
                "model": GROQ_MODEL,
                "response_format": "verbose_json",
                "timestamp_granularities": ["word", "segment"],
            }

            if whisper_language:
                kwargs["language"] = whisper_language

            try:
                transcription = client.audio.transcriptions.create(**kwargs)
            finally:
                kwargs["file"].close()

            if progress:
                progress(0.90, "Processing Groq transcript...")

            # Groq SDK returns an object with attributes.
            language_code = getattr(transcription, "language", None) or (
                whisper_language or "en"
            )

            raw_text = getattr(transcription, "text", "") or ""

            words: list[dict] = []
            segments: list[dict] = []

            raw_segments = getattr(transcription, "segments", None) or []
            raw_words = getattr(transcription, "words", None) or []

            # Word timestamps
            for w in raw_words:
                word = getattr(w, "word", None)
                start = getattr(w, "start", None)
                end = getattr(w, "end", None)

                if word is None and isinstance(w, dict):
                    word = w.get("word")
                    start = w.get("start")
                    end = w.get("end")

                if not word:
                    continue

                words.append(
                    {
                        "word": str(word).strip(),
                        "start": float(start or 0),
                        "end": float(end or 0),
                    }
                )

            # Segment timestamps
            for i, seg in enumerate(raw_segments):
                if isinstance(seg, dict):
                    start = seg.get("start", 0)
                    end = seg.get("end", 0)
                    text = seg.get("text", "")
                    seg_id = seg.get("id", i)
                else:
                    start = getattr(seg, "start", 0)
                    end = getattr(seg, "end", 0)
                    text = getattr(seg, "text", "")
                    seg_id = getattr(seg, "id", i)

                segments.append(
                    {
                        "id": int(seg_id) if str(seg_id).isdigit() else i,
                        "start": float(start or 0),
                        "end": float(end or 0),
                        "text": str(text or "").strip(),
                    }
                )

            # Fallback duration if ffprobe didn't return one.
            if duration <= 0:
                if segments:
                    duration = max(s["end"] for s in segments)
                elif words:
                    duration = max(w["end"] for w in words)

            result = {
                "language": language_code,
                "duration": float(duration),
                "text": raw_text.strip(),
                "words": words,
                "segments": segments,
            }

        finally:
            try:
                audio_path.unlink(missing_ok=True)
            except Exception:
                pass

        if (language or "").strip().lower() == "hinglish":
            from . import translit
            result = translit.romanize_transcript(result)

        transcript_path = TRANSCRIPTS_DIR / f"{clip_id}.json"

        try:
            transcript_path.write_text(
                json.dumps(
                    result,
                    ensure_ascii=False,
                    indent=2,
                ),
                encoding="utf-8",
            )
        except OSError as exc:
            logger.warning(
                "Could not write transcript json: %s",
                exc,
            )

        if progress:
            progress(1.0, "Transcription complete.")

        return result

    except Exception as exc:
        logger.exception(
            "Groq transcription failed for %s",
            video_path,
        )

        raise TranscriptionError(
            f"Groq transcription failed: {exc}"
        ) from exc
PY
